<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.trackmywealth</groupId>
    <artifactId>backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>TrackMyWealth Backend</name>
    <description>
        REST API and persistence layer for TrackMyWealth - a privacy-first personal finance
        and wealth-management platform for Switzerland and Germany. See /docs for the
        requirements baseline and database design this module implements.
    </description>

    <properties>
        <java.version>17</java.version>
        <springdoc.version>3.1.1</springdoc.version>
        <archunit.version>1.5.1</archunit.version>
        <spotless-maven-plugin.version>3.10.3</spotless-maven-plugin.version>
        <maven-pmd-plugin.version>3.28.0</maven-pmd-plugin.version>
        <spotbugs-maven-plugin.version>4.10.4.1</spotbugs-maven-plugin.version>
        <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>

        <!-- JaCoCo coverage gate (#193), measured with ./mvnw clean verify (839 tests):
               overall   lines 5247/5488 (95.61 %)  branches 1513/1711 (88.43 %)
               service   lines 3481/3578 (97.29 %)  branches 1221/1366 (89.39 %)
               security  lines  186/189  missed 3   branches   73/82  missed 9
               web       lines  140/149  missed 9   branches   70/82  missed 12
               config    lines  300/315  missed 15  branches   67/90  missed 23
             overall and service are large, so they hold a covered ratio of the baseline rounded
             down to the whole percent, minus one point (lines/branches 1.6 / 1.4 points below
             it overall): room for roughly 88 lines / 24 branches (overall) and 46 / 19
             (service) of honest, partly tested growth before the build goes red.
             security, web and config are small - one branch moves their ratio by more than a
             point - so they cap the absolute number of missed lines/branches instead, at the
             baseline plus 2. New code that is fully tested never trips them; more than two new
             untested branches there does.
             Tighten a limit when coverage has grown for good; loosen one only with a stated
             reason in the PR that does it - never to get a red build through. -->
        <coverage.overall.line>0.94</coverage.overall.line>
        <coverage.overall.branch>0.87</coverage.overall.branch>
        <coverage.service.line>0.96</coverage.service.line>
        <coverage.service.branch>0.88</coverage.service.branch>
        <coverage.security.missed.lines>5</coverage.security.missed.lines>
        <coverage.security.missed.branches>11</coverage.security.missed.branches>
        <coverage.web.missed.lines>11</coverage.web.missed.lines>
        <coverage.web.missed.branches>14</coverage.web.missed.branches>
        <coverage.config.missed.lines>17</coverage.config.missed.lines>
        <coverage.config.missed.branches>25</coverage.config.missed.branches>
    </properties>

    <dependencies>
        <!-- Web / REST -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Validation (server-side validation is mandatory regardless of client validation) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Persistence -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Schema migrations: applied automatically on every application startup.
             See DatabaseBootstrapInitializer for pre-Flyway database creation, and
             docs/architecture/adr/0001-database-auto-migration.md for the full rationale.
             Spring Boot 4 split FlywayAutoConfiguration out of the (now-modularized)
             spring-boot-autoconfigure jar into its own artifact - spring-boot-starter-flyway is
             the one that actually wires migrate-on-startup back up; flyway-core alone (still
             needed, e.g. as a compile-time API dependency) is not sufficient by itself anymore. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Security -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.13.0</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.13.0</version>
            <scope>runtime</scope>
        </dependency>
        <!-- Argon2id password hashing (FR-AUT-007): Spring Security's Argon2PasswordEncoder
             requires a BouncyCastle Argon2 implementation on the classpath. -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.86</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.13.0</version>
            <scope>runtime</scope>
        </dependency>
        <!-- FR-AUT-010: per-source (IP) rate limiting on authentication-adjacent endpoints
             (#48). In-memory token-bucket implementation - sufficient for this project's
             current single-instance self-hosted deployment target; see RateLimitFilter. -->
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j_jdk17-core</artifactId>
            <version>8.20.0</version>
        </dependency>
        <!-- #60: bounds RateLimitFilter's in-memory bucket store so a caller spread across many
             source addresses (e.g. a routed IPv6 block) can't grow it unboundedly between sweeps. -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
            <version>3.3.0</version>
        </dependency>

        <!-- OpenAPI contract - FR-API-001: the spec is generated from and validated
             against the implementation, and is a release deliverable. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- US-02-04: RFC 6238 TOTP secret generation, otpauth:// URI building, and code
             verification (with the library's own clock-skew tolerance). No QR-image rendering
             module pulled in - the mobile client renders the QR from the returned otpauth:// URI. -->
        <dependency>
            <groupId>dev.samstevens.totp</groupId>
            <artifactId>totp</artifactId>
            <version>1.7.1</version>
        </dependency>

        <!-- Background jobs (price refresh, daily valuation build, reconciliation runs -
             FR-JOB-001..007) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-quartz</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <version>1.21.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>1.21.4</version>
            <scope>test</scope>
        </dependency>

        <!-- Architecture rules (see docs/architecture/development-standards.md) enforced as
             ordinary JUnit 5 tests, not just documented convention - e.g. no code path branching
             on Account.getAccountType() (FR-ACC-012), DTOs only across the REST boundary. -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- Formatting: google-java-format, enforced (not just suggested) - `mvn spotless:apply`
                 fixes locally, `mvn verify` fails the build on unformatted code. -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless-maven-plugin.version}</version>
                <configuration>
                    <java>
                        <googleJavaFormat/>
                        <removeUnusedImports/>
                        <importOrder/>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>verify</phase>
                    </execution>
                </executions>
            </plugin>

            <!-- Static analysis: bug-pattern / best-practice checks beyond what formatting catches. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>${maven-pmd-plugin.version}</version>
                <configuration>
                    <rulesets>
                        <ruleset>category/java/bestpractices.xml</ruleset>
                        <ruleset>category/java/errorprone.xml</ruleset>
                        <ruleset>category/java/security.xml</ruleset>
                    </rulesets>
                    <printFailingErrors>true</printFailingErrors>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>verify</phase>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>${spotbugs-maven-plugin.version}</version>
                <configuration>
                    <effort>Max</effort>
                    <threshold>Medium</threshold>
                    <excludeFilterFile>spotbugs-exclude.xml</excludeFilterFile>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>verify</phase>
                    </execution>
                </executions>
            </plugin>

            <!-- Coverage report plus a gate (#193): `check` fails `verify` when coverage breaks the
                 coverage.* limits above. The overall rule protects the baseline as a whole; the
                 per-package rules keep a regression in business (service), auth-critical
                 (security), HTTP-contract (web) or security-configuration (config: SecurityConfig,
                 JWT secret policy, the denial-audit pool) code from hiding behind the much larger
                 rest - service alone is two thirds of all lines. No class is excluded: nothing here
                 is generated, and the bootstrap main() is three lines that cannot move a ratio. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <phase>test</phase>
                    </execution>
                    <execution>
                        <id>check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>verify</phase>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${coverage.overall.line}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${coverage.overall.branch}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>com.trackmywealth.backend.service</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${coverage.service.line}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${coverage.service.branch}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>com.trackmywealth.backend.security</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>MISSEDCOUNT</value>
                                            <maximum>${coverage.security.missed.lines}</maximum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>MISSEDCOUNT</value>
                                            <maximum>${coverage.security.missed.branches}</maximum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>com.trackmywealth.backend.web</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>MISSEDCOUNT</value>
                                            <maximum>${coverage.web.missed.lines}</maximum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>MISSEDCOUNT</value>
                                            <maximum>${coverage.web.missed.branches}</maximum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>com.trackmywealth.backend.config</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>MISSEDCOUNT</value>
                                            <maximum>${coverage.config.missed.lines}</maximum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>MISSEDCOUNT</value>
                                            <maximum>${coverage.config.missed.branches}</maximum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
