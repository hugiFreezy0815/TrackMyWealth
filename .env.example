# Copy to .env (next to docker-compose.yml; never commit it) and replace every value marked
# CHANGE-ME. docker compose reads it automatically. Generate secrets with: openssl rand -base64 32

# FR-AUT-003/005: signs access tokens. Required.
JWT_SECRET=CHANGE-ME
# US-02-04: encrypts each user's TOTP secret at rest. Back it up with the database.
MFA_ENCRYPTION_KEY=CHANGE-ME

# The PostgreSQL superuser's password. Used only for provisioning, never by the backend once the
# roles are split. Takes effect when the data volume is first created.
POSTGRES_PASSWORD=CHANGE-ME
# PostgreSQL's port is published on this machine's loopback only. Uncomment to reach it from
# other machines too (e.g. a database tool on your LAN) - then use strong passwords above.
# POSTGRES_PUBLISH_ADDRESS=0.0.0.0

# US-28-05: database role split (README, "Database roles"). The backend connects as the
# RLS-bound runtime role; Flyway runs as the migration role, which owns the schema. On a fresh
# volume the roles are created automatically; for an existing installation, run the upgrade in
# the README first. Each password needs at least 16 characters and its own value. Remove the five
# DB_* lines to keep a single-role setup.
DB_USERNAME=trackmywealth_runtime
DB_PASSWORD=CHANGE-ME
DB_MIGRATION_USERNAME=trackmywealth_migration
DB_MIGRATION_PASSWORD=CHANGE-ME
# Refuse to start if the backend ever connects as a role that bypasses row-level security.
DB_REQUIRE_RLS_BOUND_ROLE=true
