# Expo SDK 58 pins React Native 0.88.0-rc.4. npm semver ranges such as ">=0.78" never match a
# prerelease, so every package with a react-native peer range rejects it (for example
# @testing-library/react-native), and npm "overrides" cannot rewrite peer ranges. This is the
# only npm-native way to install the SDK. Because it also hides genuine peer conflicts, Mobile Web
# CI runs `npx expo install --check` to validate versions against the SDK's own list.
# Remove this once Expo SDK 58 ships a stable React Native 0.88.
legacy-peer-deps=true
