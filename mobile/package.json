{
  "name": "trackmywealth-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "expo": "~58.0.22",
    "expo-constants": "~58.0.13",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.10",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-screen-capture": "~58.0.6",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "@tanstack/react-query": "5.107.1",
    "@react-native-community/netinfo": "12.0.1",
    "react-intl": "7.1.14",
    "@formatjs/intl-numberformat": "10.0.2",
    "@formatjs/intl-datetimeformat": "8.0.2",
    "@formatjs/intl-pluralrules": "7.0.2",
    "@formatjs/intl-displaynames": "8.0.1",
    "expo-document-picker": "58.0.4",
    "@react-native-community/datetimepicker": "9.2.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "~30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-expo": "~58.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "api:types": "node scripts/generate-api-types.mjs",
    "api:types:check": "node scripts/generate-api-types.mjs --check"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "jest",
        "@types/jest"
      ]
    }
  },
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 15000,
    "moduleNameMapper": {
      "^@/assets/(.*)$": "<rootDir>/assets/$1",
      "^\\./catalogue-context$": "<rootDir>/src/i18n/jest-catalogue-context.cjs"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|@formatjs))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  },
  "overrides": {
    "uuid": "^11.1.1",
    "decode-uri-component": "^0.5.0"
  }
}
