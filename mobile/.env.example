# Copy to .env and adjust as needed. Expo inlines any EXPO_PUBLIC_* variable into the JS
# bundle at build time (see https://docs.expo.dev/guides/environment-variables/) - no extra
# config library required.
#
# Android emulators cannot reach the host machine via localhost; use 10.0.2.2 instead.
# iOS simulators and Expo Go on a physical device on the same network can use your machine's
# LAN IP (see `ipconfig getifaddr en0` on macOS) or localhost for the simulator.
EXPO_PUBLIC_API_URL=http://localhost:8080
